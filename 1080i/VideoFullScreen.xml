<?xml version="1.0" encoding="UTF-8"?>
<window>
    <include condition="!Skin.HasSetting(p3i.codecs.video.disabled)">P3I_Codecs_Video_Autohide</include>
    <onload>ClearProperty(OSDRelaunchFullscreen,Home)</onload>
    <controls>
        <control type="grouplist" id="0">
            <orientation>vertical</orientation>
            <centertop>100</centertop>
            <height>120</height>
            <left>80</left>
            <include content="Overlay_InfoLabel">
                <param name="id">10</param>
                <textcolor>panel_fg_100</textcolor>
                <textoffsetx>10</textoffsetx>
                <font>font_mini</font>
            </include>
            <include content="Overlay_InfoLabel">
                <param name="id">11</param>
                <textcolor>panel_fg_100</textcolor>
                <textoffsetx>10</textoffsetx>
                <font>font_mini</font>
            </include>
            <include content="Overlay_InfoLabel">
                <param name="id">12</param>
                <textcolor>panel_fg_100</textcolor>
                <textoffsetx>10</textoffsetx>
                <font>font_mini</font>
            </include>
        </control>
        <include>P3I_Codecs_Video</include>
    </controls>
</window>