<?xml version="1.0" encoding="UTF-8"?>
<window>
    <include condition="!Skin.HasSetting(p3i.ppi.disabled)">P3I_PPI_On_Load</include>
    <defaultcontrol always="true">5</defaultcontrol>
    <onload>CancelAlarm(osd_timeout,true)</onload>
    <controls>
        <include condition="!Skin.HasSetting(p3i.ppi.disabled)">P3I_PPI</include>

        <control type="group">
            <include condition="Skin.HasSetting(p3i.ppi.disabled)">Animation_SlideIn_Dialog</include>
            <include condition="Skin.HasSetting(p3i.ppi.disabled)" content="Furniture_Header">
                <param name="label">[CAPITALIZE]$LOCALIZE[10116][/CAPITALIZE]</param>
                <param name="include_right">false</param>
                <param name="textcolor">main_fg_90</param>
            </include>
            <control type="group">
                <visible>Skin.HasSetting(p3i.ppi.disabled)</visible>
                <left>view_pad</left>
                <right>view_pad</right>
                <top>140</top>
                <include>DialogProcessInfo_Details</include>
                <include>DialogProcessInfo_Lanes</include>
            </control>
        </control>
    </controls>
</window>
