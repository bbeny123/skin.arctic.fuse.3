<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1159">
    <defaultcontrol always="true">6009</defaultcontrol>

    <controls>
        <control type="group">
            <include>OSD_HideControls</include>
            <left>view_pad</left>
            <right>view_pad</right>

            <visible>!Window.IsActive(DialogPlayerProcessInfo.xml)</visible>
            <visible>!Window.IsVisible(DialogSlider.xml)</visible>

            <control type="group">
                <visible>System.AddonIsEnabled(service.coreelec.settings)</visible>
                <visible>!Window.IsVisible(DialogSettings.xml)</visible>

                <include>OSD_Part_Background_Blur</include>
                <include content="Animation_SlideIn_Dialog">
                    <param name="posy">48</param>
                </include>
                <include>OSD_Stream_Selector_Divider</include>
                <right>-40</right>
                <bottom>220</bottom>
                <width>450</width>
                <include content="P3I_VS10_Menu_Height" condition="Integer.IsEqual(Player.Process(video.source.hdr.type.raw),3)">
                    <param name="height">440</param>
                </include>
                <include content="P3I_VS10_Menu_Height" condition="!Integer.IsEqual(Player.Process(video.source.hdr.type.raw),3)">
                    <param name="height">520</param>
                </include>

                <include content="Object_MenuHeader">
                    <param name="label">VS10</param>
                    <param name="icon">special://skin/p3i/icons/vs10.png</param>
                </include>

                <control type="group">
                    <top>120</top>
                    <bottom>40</bottom>

                    <control type="grouplist" id="6210">
                        <top>20</top>
                        <bottom>20</bottom>
                        <left>20</left>
                        <right>20</right>
                        <ondown>6009</ondown>
                        <onleft>6009</onleft>
                        <onright>6009</onright>
                        <onup>noop</onup>
                        <orientation>vertical</orientation>

                        <!-- VS10 Dolby Vision -->
                        <include content="P3I_VS10_Button" condition="!Integer.IsEqual(Player.Process(video.source.hdr.type.raw),3)">
                            <param name="group_id">6894</param>
                            <param name="id">8490</param>
                            <param name="mode">Dolby Vision</param>
                            <param name="target">-> Dolby Vision</param>
                            <param name="action">vs10.dv</param>
                            <param name="active">!Integer.IsEqual(Player.Process(video.hdr.type.raw),3) + String.StartsWith(Player.Process(amlogic.vs10.mode),Dolby)</param>
                            <param name="icon">arrows-rotate</param>
                        </include>

                        <!-- VS10 HDR10 -->
                        <include content="P3I_VS10_Button">
                            <param name="group_id">6895</param>
                            <param name="id">8491</param>
                            <param name="mode">HDR10</param>
                            <param name="target">-> HDR10</param>
                            <param name="action">vs10.hdr10</param>
                            <param name="active">Integer.IsEqual(Player.Process(amlogic.vs10.mode.raw),2)</param>
                            <param name="icon">arrows-rotate</param>
                        </include>

                        <!-- VS10 SDR -->
                        <include content="P3I_VS10_Button">
                            <param name="group_id">6896</param>
                            <param name="id">8492</param>
                            <param name="mode">SDR</param>
                            <param name="target">-> SDR</param>
                            <param name="action">vs10.sdr</param>
                            <param name="active">Integer.IsEqual(Player.Process(amlogic.vs10.mode.raw),3) | Integer.IsEqual(Player.Process(amlogic.vs10.mode.raw),4)</param>
                            <param name="icon">arrows-rotate</param>
                        </include>

                        <!-- VS10 Original -->
                        <include content="P3I_VS10_Button">
                            <param name="group_id">6897</param>
                            <param name="id">8493</param>
                            <param name="mode">Original</param>
                            <param name="action">vs10.original</param>
                            <param name="active">Integer.IsEqual(Player.Process(amlogic.vs10.mode.raw),5) | [Integer.IsEqual(Player.Process(video.hdr.type.raw),3) + String.StartsWith(Player.Process(amlogic.vs10.mode),Dolby)]</param>
                            <param name="icon">circle-notch</param>
                        </include>

                    </control>
                </control>
            </control>

            <include content="OSD_CustomDialog_GroupList">
                <param name="onclick">ActivateWindow(playerprocessinfo)</param>
                <param name="onup">SetFocus(8493)</param>
                <param name="icon">special://skin/p3i/icons/ppi.png</param>
                <param name="button_9">true</param>
            </include>
        </control>
    </controls>
</window>